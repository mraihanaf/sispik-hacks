# PostgreSQL (matches the root docker-compose.yaml defaults)
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal?schema=public"

# Better Auth: generate a high-entropy value at least 32 characters long.
BETTER_AUTH_SECRET="replace-with-a-generated-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Trigger.dev (optional until background tasks are deployed)
TRIGGER_SECRET_KEY="tr_dev_..."

# S3-compatible object storage. Local MinIO defaults are shown below.
STORAGE_BUCKET="portal"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_ENDPOINT="http://localhost:9000"

# MQTT. Only the WSS endpoint is safe to expose to the browser.
MQTT_BROKER_INTERNAL_URL="mqtt://localhost:1883"
# Use 127.0.0.1 locally so browser localhost cookies are not sent to EMQX.
NEXT_PUBLIC_MQTT_BROKER_WSS_URL="ws://127.0.0.1:8083/mqtt"
# Optional MapLibre-compatible style JSON. If unset, the app uses OpenStreetMap raster tiles.
# Set this to your own provider/style for production control.
NEXT_PUBLIC_MAP_STYLE_URL=""
# OSRM routing endpoint. It is called only from server-side oRPC procedures.
OSRM_BASE_URL="https://router.project-osrm.org"
MQTT_SERVER_CLIENT_ID="sispik-dashboard"
MQTT_SERVER_USERNAME=""
MQTT_SERVER_PASSWORD=""
MQTT_JWT_SECRET="replace-with-a-long-random-secret"
IOT_INGESTOR_SERVICE_TOKEN="replace-with-a-long-random-service-token"
ENABLE_DEMO_CONTROLS=false
ENABLE_SIMULATOR_DEV_API=false
SIMULATOR_ALLOWED_ORIGIN="http://localhost:4200"
